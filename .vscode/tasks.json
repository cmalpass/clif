{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "build",
        "${workspaceFolder}/clif.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "test",
        "${workspaceFolder}/CLIF.Tests/CLIF.Tests.csproj",
        "--no-build",
        "--logger",
        "trx",
        "--results-directory",
        "${workspaceFolder}/TestResults"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "test:unit",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "test",
        "${workspaceFolder}/CLIF.Tests/CLIF.Tests.csproj",
        "--no-build",
        "--filter",
        "FullyQualifiedName~Unit",
        "--logger",
        "console;verbosity=normal",
        "--results-directory",
        "${workspaceFolder}/TestResults"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test:integration",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "test",
        "${workspaceFolder}/CLIF.Tests/CLIF.Tests.csproj",
        "--no-build",
        "--filter",
        "FullyQualifiedName~Integration",
        "--logger",
        "console;verbosity=normal",
        "--results-directory",
        "${workspaceFolder}/TestResults"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "test:wpf-ui",
      "detail": "Launches TestWpfApp.exe (via WpfTestAppFixture) and runs FlaUI-based UI automation tests. Requires the solution to be built first.",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "test",
        "${workspaceFolder}/CLIF.Tests/CLIF.Tests.csproj",
        "--no-build",
        "--filter",
        "Category=WpfUI",
        "--logger",
        "console;verbosity=detailed",
        "--results-directory",
        "${workspaceFolder}/TestResults"
      ],
      "problemMatcher": "$msCompile",
      "group": "test",
      "dependsOn": "build"
    }
  ]
}
