{
  "dotnet.defaultSolutionOrFolder": "${workspaceFolder}/clif.sln",
  "dotnet.autoGenerateConfigurationFiles": true,
  "dotnet.server.useOmnisharp": false,
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true
  },
  "explorer.excludeGitignore": true,
  "files.exclude": {
    "**/.git": true,
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true
  },
  "dotnet.defaultSolution": "${workspaceFolder}/clif.sln",
  // Point the VS Code .NET test runner at the project-level runsettings file so
  // that xUnit collection behaviour, results directory and target framework are
  // applied consistently whether tests are run from the editor or the terminal.
  "dotnet.testRunSettings": "${workspaceFolder}/CLIF.Tests/.runsettings"
}
