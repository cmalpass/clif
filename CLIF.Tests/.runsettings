<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>4</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <TargetFramework>net8.0-windows</TargetFramework>
  </RunConfiguration>

  <!--
    Set TEST_WPF_APP_PATH as an environment variable to override the TestWpfApp
    binary location used by WpfTestAppFixture.  The <EnvironmentVariables> section
    below is the correct mechanism: variables defined here are injected into the
    test-host process and read by Environment.GetEnvironmentVariable().
    Uncomment and set the value to redirect the fixture to a specific binary.
  -->
  <EnvironmentVariables>
    <!-- <Variable name="TEST_WPF_APP_PATH" value="C:\path\to\TestWpfApp.exe" /> -->
  </EnvironmentVariables>

  <TestAdapterSettings>
    <xUnit>
      <DiagnosticMessages>false</DiagnosticMessages>
      <!--
        CollectionPerAssembly: each test class that does not declare a collection
        is placed in its own implicit collection, preventing cross-class
        parallelism for tests that share mutable state.
        Tests in the "WpfUI" collection always run sequentially (one shared fixture).
      -->
      <CollectionBehavior>CollectionPerAssembly</CollectionBehavior>
    </xUnit>
  </TestAdapterSettings>

  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>minimal</Verbosity>
        </Configuration>
      </Logger>
    </Loggers>
  </LoggerRunSettings>
</RunSettings>
