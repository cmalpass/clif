{
  "name": "Quick WPF Validation Test",
  "description": "Quick validation of core WPF control functionality",
  "version": "1.0",
  "target": {
    "processName": "TestWpfApp",
    "timeoutMs": 30000
  },
  "options": {
    "stopOnError": true,
    "logSteps": true,
    "takeScreenshots": true,
    "defaultTimeoutMs": 30000,
    "delayBetweenActionsMs": 500
  },
  "steps": [
    {
      "action": "log",
      "description": "=== Quick WPF Validation Test ==="
    },
    {
      "action": "screenshot",
      "description": "Initial state"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear text box"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "value": "Quick Test",
      "description": "Enter test text"
    },
    {
      "action": "validate",
      "element": "id=TestTextBox",
      "value": "Quick Test",
      "description": "Validate text entry"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Click main button"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Toggle checkbox"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 2",
      "description": "Select combo item"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "42",
      "description": "Set slider value"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 2",
      "description": "Switch tabs"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 1",
      "description": "Return to Tab 1"
    },
    {
      "action": "selectRow",
      "element": "id=TestDataGrid",
      "parameters": {
        "index": 1
      },
      "description": "Select data grid row"
    },
    {
      "action": "screenshot",
      "description": "Final state"
    },
    {
      "action": "log",
      "description": "Quick validation test completed successfully!"
    }
  ]
}
