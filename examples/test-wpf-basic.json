{
  "name": "Test WPF App Basic Interaction",
  "description": "Demonstrates basic interactions with the test WPF application",
  "version": "1.0",
  "target": {
    "processName": "TestWpfApp",
    "timeoutMs": 30000
  },
  "options": {
    "stopOnError": true,
    "logSteps": true,
    "takeScreenshots": true,
    "defaultTimeoutMs": 30000,
    "delayBetweenActionsMs": 0
  },
  "steps": [
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Click the test button"
    },
    {
      "action": "wait",
      "delayMs": 1000,
      "description": "Wait after click"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear the text box"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "value": "Hello from CLIF automation!",
      "description": "Type test message into text box"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Check the checkbox"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 2",
      "description": "Select option from combobox"
    },
    {
      "action": "screenshot",
      "description": "Take final screenshot"
    }
  ]
}
