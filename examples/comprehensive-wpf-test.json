{
  "name": "Comprehensive WPF Controls Test",
  "description": "Thorough testing of all WPF controls in the TestWpfApp",
  "version": "1.0",
  "target": {
    "processName": "TestWpfApp",
    "timeoutMs": 120000
  },
  "options": {
    "stopOnError": false,
    "logSteps": true,
    "takeScreenshots": true,
    "defaultTimeoutMs": 120000,
    "delayBetweenActionsMs": 800
  },
  "steps": [
    {
      "action": "screenshot",
      "description": "Initial state of the application"
    },
    {
      "action": "log",
      "description": "=== Starting Comprehensive WPF Controls Test ==="
    },
    {
      "action": "log",
      "description": "Phase 1: Testing Basic Input Controls"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear the main text box"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "value": "CLIF Automation Test",
      "description": "Type test text into main text box"
    },
    {
      "action": "validate",
      "element": "id=TestTextBox",
      "value": "CLIF Automation Test",
      "description": "Verify text was entered correctly"
    },
    {
      "action": "clear",
      "element": "id=TestPasswordBox",
      "description": "Clear the password box"
    },
    {
      "action": "type",
      "element": "id=TestPasswordBox",
      "value": "SecurePass123",
      "description": "Type password into password box"
    },
    {
      "action": "screenshot",
      "description": "After text input"
    },
    {
      "action": "log",
      "description": "Phase 2: Testing Selection Controls"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Toggle the main checkbox"
    },
    {
      "action": "click",
      "element": "id=RadioButton1",
      "description": "Select first radio button"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "id=RadioButton2",
      "description": "Select second radio button"
    },
    {
      "action": "click",
      "element": "id=TestToggleButton",
      "description": "Toggle the toggle button"
    },
    {
      "action": "screenshot",
      "description": "After selection controls"
    },
    {
      "action": "log",
      "description": "Phase 3: Testing Dropdown and List Controls"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 2",
      "description": "Select item from combo box"
    },
    {
      "action": "select",
      "element": "id=TestListBox",
      "value": "List Item 2",
      "description": "Select item from list box"
    },
    {
      "action": "screenshot",
      "description": "After dropdown selections"
    },
    {
      "action": "log",
      "description": "Phase 4: Testing Range and Progress Controls"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "25",
      "description": "Set slider to 25%"
    },
    {
      "action": "wait",
      "delayMs": 1000
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "75",
      "description": "Set slider to 75%"
    },
    {
      "action": "screenshot",
      "description": "After slider adjustments"
    },
    {
      "action": "log",
      "description": "Phase 5: Testing Date Controls"
    },
    {
      "action": "setValue",
      "element": "id=TestDatePicker",
      "value": "2025-12-25",
      "description": "Set date picker value"
    },
    {
      "action": "screenshot",
      "description": "After date selection"
    },
    {
      "action": "log",
      "description": "Phase 6: Testing Tab Navigation"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 2",
      "description": "Switch to Tab 2"
    },
    {
      "action": "wait",
      "delayMs": 1000
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 3",
      "description": "Switch to Tab 3"
    },
    {
      "action": "wait",
      "delayMs": 1000
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 1",
      "description": "Return to Tab 1"
    },
    {
      "action": "screenshot",
      "description": "After tab navigation"
    },
    {
      "action": "log",
      "description": "Phase 7: Testing Tree View"
    },
    {
      "action": "expand",
      "element": "id=TestTreeView",
      "value": "Root Item",
      "description": "Expand root tree node"
    },
    {
      "action": "select",
      "element": "id=TestTreeView",
      "value": "Child Item 1",
      "description": "Select child item in tree"
    },
    {
      "action": "screenshot",
      "description": "After tree interaction"
    },
    {
      "action": "log",
      "description": "Phase 8: Testing Data Grid"
    },
    {
      "action": "selectRow",
      "element": "id=TestDataGrid",
      "parameters": {
        "index": 0
      },
      "description": "Select first row in data grid"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "selectRow",
      "element": "id=TestDataGrid",
      "parameters": {
        "index": 1
      },
      "description": "Select second row in data grid"
    },
    {
      "action": "selectCell",
      "element": "id=TestDataGrid",
      "row": 2,
      "column": 1,
      "description": "Select specific cell in data grid"
    },
    {
      "action": "screenshot",
      "description": "After data grid interaction"
    },
    {
      "action": "log",
      "description": "Phase 9: Testing Menu and Toolbar"
    },
    {
      "action": "click",
      "element": "id=FileMenu",
      "description": "Open File menu"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "id=NewMenuItem",
      "description": "Click New menu item"
    },
    {
      "action": "click",
      "element": "id=SaveToolbarButton",
      "description": "Click Save toolbar button"
    },
    {
      "action": "screenshot",
      "description": "After menu/toolbar interaction"
    },
    {
      "action": "log",
      "description": "Phase 10: Testing Rich Text and Expander"
    },
    {
      "action": "expand",
      "element": "id=TestExpander",
      "description": "Expand the expander control"
    },
    {
      "action": "clear",
      "element": "id=TestRichTextBox",
      "description": "Clear rich text box"
    },
    {
      "action": "type",
      "element": "id=TestRichTextBox",
      "value": "Rich text content from CLIF automation\nSecond line of text\nThird line with formatting",
      "description": "Add rich text content"
    },
    {
      "action": "screenshot",
      "description": "After rich text and expander"
    },
    {
      "action": "log",
      "description": "Phase 11: Testing All Buttons"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Click main test button"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "id=StandardButton",
      "description": "Click standard button"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "id=DefaultButton",
      "description": "Click default button"
    },
    {
      "action": "screenshot",
      "description": "After button clicks"
    },
    {
      "action": "log",
      "description": "Phase 12: Stress Testing - Rapid Interactions"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Rapid checkbox toggle 1"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Rapid checkbox toggle 2"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "10",
      "description": "Rapid slider change 1"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "90",
      "description": "Rapid slider change 2"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "50",
      "description": "Rapid slider change 3"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 1",
      "description": "Rapid combo selection 1"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 3",
      "description": "Rapid combo selection 2"
    },
    {
      "action": "screenshot",
      "description": "After stress testing"
    },
    {
      "action": "log",
      "description": "Phase 13: Final Validation"
    },
    {
      "action": "validate",
      "element": "id=TestTextBox",
      "value": "CLIF Automation Test",
      "description": "Validate text box still contains test text"
    },
    {
      "action": "getState",
      "element": "id=TestCheckBox",
      "description": "Get final checkbox state"
    },
    {
      "action": "getValue",
      "element": "id=TestSlider",
      "description": "Get final slider value"
    },
    {
      "action": "getSelection",
      "element": "id=TestComboBox",
      "description": "Get final combo box selection"
    },
    {
      "action": "log",
      "description": "Phase 14: Application State Reset"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Reset text box"
    },
    {
      "action": "clear",
      "element": "id=TestPasswordBox",
      "description": "Reset password box"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "50",
      "description": "Reset slider to middle"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 1",
      "description": "Reset combo box to first item"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 1",
      "description": "Reset to first tab"
    },
    {
      "action": "screenshot",
      "description": "Final state after reset"
    },
    {
      "action": "log",
      "description": "=== Comprehensive WPF Controls Test Completed Successfully ==="
    },
    {
      "action": "wait",
      "description": "Final pause before test completion",
      "delayMs": 2000
    }
  ]
}
