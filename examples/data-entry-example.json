{
  "name": "Data Entry Automation",
  "description": "Automated data entry example",
  "version": "1.0",
  "target": {
    "processName": "TestWpfApp",
    "timeoutMs": 60000
  },
  "options": {
    "stopOnError": true,
    "logSteps": true,
    "takeScreenshots": false,
    "defaultTimeoutMs": 60000,
    "delayBetweenActionsMs": 0
  },
  "steps": [
    {
      "action": "focus",
      "element": "id=TestTextBox",
      "description": "Focus on name field"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "value": "John Doe",
      "description": "Enter user name"
    },
    {
      "action": "validate",
      "element": "id=TestTextBox",
      "value": "John Doe",
      "description": "Verify name was entered correctly"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Submit form"
    }
  ]
}
