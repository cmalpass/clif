  "validation": {
    "check_status_updates": true,
    "expected_controls": [
      "OutlinedButton",
      "FlatButton", 
      "IconButton",
      "FloatingActionButton",
      "FilledTextBox",
      "FloatingHintTextBox",
      "SwitchToggleButton",
      "ActionToggleButton",
      "FlatToggleButton",
      "TestTimePicker",
      "TestRatingBar",
      "Chip1",
      "Chip2", 
      "Chip3",
      "DeletableChip",
      "TestColorPicker",
      "TestClock",
