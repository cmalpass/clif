{
  "name": "Advanced WPF Controls Test - Edge Cases",
  "description": "Testing edge cases, error handling, and advanced interactions",
  "version": "1.0",
  "target": {
    "processName": "TestWpfApp",
    "timeoutMs": 90000
  },
  "options": {
    "stopOnError": false,
    "logSteps": true,
    "takeScreenshots": true,
    "defaultTimeoutMs": 90000,
    "delayBetweenActionsMs": 1200
  },
  "steps": [
    {
      "action": "log",
      "description": "=== Advanced WPF Controls Test - Edge Cases ==="
    },
    {
      "action": "screenshot",
      "description": "Initial state for advanced testing"
    },
    {
      "action": "log",
      "description": "Phase 1: Long Text and Special Characters"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear text box for long text test"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "value": "This is a very long text string that will test the text input capabilities and scrolling behavior of the text controls. It contains multiple sentences and should wrap across multiple lines to test the text handling.",
      "description": "Enter very long text"
    },
    {
      "action": "screenshot",
      "description": "After long text entry"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear for special characters test"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "value": "Special chars: !@#$%^&*()_+-=[]{}|;':\",./<>?",
      "description": "Enter special characters"
    },
    {
      "action": "clear",
      "element": "id=TestRichTextBox",
      "description": "Clear rich text box"
    },
    {
      "action": "type",
      "element": "id=TestRichTextBox",
      "value": "Unicode test: 中文 العربية русский 日本語 🎉🚀💻",
      "description": "Enter unicode text in rich text box"
    },
    {
      "action": "screenshot",
      "description": "After special characters"
    },
    {
      "action": "log",
      "description": "Phase 2: Boundary Value Testing"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "0",
      "description": "Set slider to minimum value"
    },
    {
      "action": "wait",
      "delayMs": 1000
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "100",
      "description": "Set slider to maximum value"
    },
    {
      "action": "screenshot",
      "description": "Slider boundary values"
    },
    {
      "action": "log",
      "description": "Phase 3: Rapid Sequential Actions"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Rapid click 1"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Rapid click 2"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Rapid click 3"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Rapid checkbox 1"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Rapid checkbox 2"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Rapid checkbox 3"
    },
    {
      "action": "screenshot",
      "description": "After rapid actions"
    },
    {
      "action": "log",
      "description": "Phase 4: Complex Navigation Patterns"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 2",
      "description": "Navigate to Tab 2"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 3",
      "description": "Navigate to Tab 3"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 1",
      "description": "Return to Tab 1"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 2",
      "description": "Navigate to Tab 2 again"
    },
    {
      "action": "expand",
      "element": "id=TestTreeView",
      "value": "Root Item",
      "description": "Expand tree while on Tab 2"
    },
    {
      "action": "screenshot",
      "description": "Complex navigation state"
    },
    {
      "action": "log",
      "description": "Phase 5: Data Grid Stress Test"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 1",
      "description": "Return to main tab for data grid"
    },
    {
      "action": "selectRow",
      "element": "id=TestDataGrid",
      "parameters": {
        "index": 0
      },
      "description": "Select row 0"
    },
    {
      "action": "selectRow",
      "element": "id=TestDataGrid",
      "parameters": {
        "index": 1
      },
      "description": "Select row 1"
    },
    {
      "action": "selectRow",
      "element": "id=TestDataGrid",
      "parameters": {
        "index": 2
      },
      "description": "Select row 2"
    },
    {
      "action": "selectCell",
      "element": "id=TestDataGrid",
      "row": 0,
      "column": 0,
      "description": "Select cell (0,0)"
    },
    {
      "action": "selectCell",
      "element": "id=TestDataGrid",
      "row": 1,
      "column": 1,
      "description": "Select cell (1,1)"
    },
    {
      "action": "selectCell",
      "element": "id=TestDataGrid",
      "row": 2,
      "column": 2,
      "description": "Select cell (2,2)"
    },
    {
      "action": "screenshot",
      "description": "Data grid stress test"
    },
    {
      "action": "log",
      "description": "Phase 6: Multi-Control State Changes"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 1",
      "description": "Set combo to Item 1"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "25",
      "description": "Set slider to 25"
    },
    {
      "action": "click",
      "element": "id=RadioButton1",
      "description": "Select radio button 1"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Check the checkbox"
    },
    {
      "action": "wait",
      "delayMs": 1000
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 3",
      "description": "Change combo to Item 3"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "75",
      "description": "Change slider to 75"
    },
    {
      "action": "click",
      "element": "id=RadioButton2",
      "description": "Select radio button 2"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Uncheck the checkbox"
    },
    {
      "action": "screenshot",
      "description": "Multi-control state changes"
    },
    {
      "action": "log",
      "description": "Phase 7: Menu and Toolbar Combinations"
    },
    {
      "action": "click",
      "element": "id=FileMenu",
      "description": "Open File menu"
    },
    {
      "action": "wait",
      "delayMs": 800
    },
    {
      "action": "click",
      "element": "id=NewMenuItem",
      "description": "Select New from File menu"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "id=SaveToolbarButton",
      "description": "Click Save toolbar button"
    },
    {
      "action": "wait",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "id=EditMenu",
      "description": "Open Edit menu"
    },
    {
      "action": "wait",
      "delayMs": 800
    },
    {
      "action": "click",
      "element": "id=CopyMenuItem",
      "description": "Select Copy from Edit menu"
    },
    {
      "action": "screenshot",
      "description": "Menu and toolbar combinations"
    },
    {
      "action": "log",
      "description": "Phase 8: State Validation and Recovery"
    },
    {
      "action": "validate",
      "element": "id=TestTextBox",
      "value": "Special chars: !@#$%^&*()_+-=[]{}|;':\",./<>?",
      "description": "Validate text box contains special characters"
    },
    {
      "action": "getState",
      "element": "id=TestCheckBox",
      "description": "Get current checkbox state"
    },
    {
      "action": "getValue",
      "element": "id=TestSlider",
      "description": "Get current slider value"
    },
    {
      "action": "getSelection",
      "element": "id=TestComboBox",
      "description": "Get current combo selection"
    },
    {
      "action": "getSelection",
      "element": "id=TestListBox",
      "description": "Get current list selection"
    },
    {
      "action": "log",
      "description": "Phase 9: Cleanup and Reset"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear main text box"
    },
    {
      "action": "clear",
      "element": "id=TestRichTextBox",
      "description": "Clear rich text box"
    },
    {
      "action": "clear",
      "element": "id=TestPasswordBox",
      "description": "Clear password box"
    },
    {
      "action": "setValue",
      "element": "id=TestSlider",
      "value": "50",
      "description": "Reset slider to center"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 1",
      "description": "Reset combo to first item"
    },
    {
      "action": "selectTab",
      "element": "id=TestTabControl",
      "value": "Tab 1",
      "description": "Reset to first tab"
    },
    {
      "action": "collapse",
      "element": "id=TestExpander",
      "description": "Collapse expander"
    },
    {
      "action": "screenshot",
      "description": "Final clean state"
    },
    {
      "action": "log",
      "description": "=== Advanced WPF Controls Test Completed ==="
    },
    {
      "action": "wait",
      "description": "Final pause",
      "delayMs": 2000
    }
  ]
}
