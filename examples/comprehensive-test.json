{
  "name": "Comprehensive WPF Automation Test",
  "description": "Test all major controls in TestWpfApp to demonstrate visible automation",
  "steps": [
    {
      "action": "log",
      "message": "🎬 Starting comprehensive automation test - watch TestWpfApp for visible changes!"
    },
    {
      "action": "clear",
      "element": "id=TestTextBox",
      "description": "Clear the text box"
    },
    {
      "action": "type",
      "element": "id=TestTextBox", 
      "text": "🚀 AUTOMATION IS WORKING! Time: {{timestamp}}",
      "description": "Type animated text into the text box"
    },
    {
      "action": "click",
      "element": "id=TestButton",
      "description": "Click the Test Button (should show message box)"
    },
    {
      "action": "wait",
      "duration": 1000,
      "description": "Wait 1 second"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Toggle the checkbox"
    },
    {
      "action": "wait",
      "duration": 500,
      "description": "Wait half second"
    },
    {
      "action": "click",
      "element": "id=TestCheckBox",
      "description": "Toggle checkbox again"
    },
    {
      "action": "select",
      "element": "id=TestComboBox",
      "value": "Item 2",
      "description": "Select Item 2 from combo box"
    },
    {
      "action": "wait",
      "duration": 1000,
      "description": "Wait 1 second"
    },
    {
      "action": "select",
      "element": "id=TestComboBox", 
      "value": "Item 3",
      "description": "Select Item 3 from combo box"
    },
    {
      "action": "click",
      "element": "id=RadioButton1",
      "description": "Select Radio Button 1"
    },
    {
      "action": "wait",
      "duration": 500,
      "description": "Wait half second"
    },
    {
      "action": "click",
      "element": "id=RadioButton2", 
      "description": "Select Radio Button 2"
    },
    {
      "action": "type",
      "element": "id=TestPasswordBox",
      "text": "SecretPassword123",
      "description": "Type into password box"
    },
    {
      "action": "click",
      "element": "id=ToggleButton",
      "description": "Toggle the toggle button"
    },
    {
      "action": "wait",
      "duration": 1000,
      "description": "Wait 1 second"
    },
    {
      "action": "type",
      "element": "id=TestTextBox",
      "text": " ✅ COMPLETE!",
      "description": "Append completion message"
    },
    {
      "action": "log",
      "message": "🎉 Comprehensive test complete! Check TestWpfApp - you should see multiple visible changes!"
    }
  ]
}