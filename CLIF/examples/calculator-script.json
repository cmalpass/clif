{
  "name": "Sample Calculator Script",
  "description": "Demonstrates basic calculator automation",
  "version": "1.0",
  "target": {
    "processName": "Calculator",
    "windowTitle": "Calculator",
    "timeoutMs": 30000
  },
  "steps": [
    {
      "action": "click",
      "element": "name=Five",
      "description": "Click the number 5",
      "delayMs": 500
    },
    {
      "action": "click", 
      "element": "name=Plus",
      "description": "Click the plus operator",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "name=Three", 
      "description": "Click the number 3",
      "delayMs": 500
    },
    {
      "action": "click",
      "element": "name=Equals",
      "description": "Click equals to calculate result",
      "delayMs": 500
    },
    {
      "action": "get-text",
      "element": "id=CalculatorResults",
      "description": "Get the calculation result",
      "parameters": {
        "saveAs": "result"
      }
    }
  ],
  "options": {
    "stopOnError": true,
    "logSteps": true,
    "takeScreenshots": false,
    "defaultTimeoutMs": 5000,
    "outputPath": "./output/calculator-test.log"
  }
}